<div class="month-selector">
    <button type="button"
            class="month-selector__btn"
            aria-label="Previous month"
            disabled="@IsFirst"
            @onclick="Previous">
        <Icon Name="chevron-left" />
    </button>
    <p class="month-selector__label" aria-live="polite">@Selected.ToString("MMMM yyyy")</p>
    <button type="button"
            class="month-selector__btn"
            aria-label="Next month"
            disabled="@IsLast"
            @onclick="Next">
        <Icon Name="chevron-right" />
    </button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DateOnly> Months { get; set; } = [];
    [Parameter, EditorRequired] public DateOnly Selected { get; set; }
    [Parameter] public EventCallback<DateOnly> SelectedChanged { get; set; }

    private bool IsFirst => Months.Count == 0 || Selected <= Months[0];
    private bool IsLast => Months.Count == 0 || Selected >= Months[^1];

    private Task Previous() => Shift(-1);
    private Task Next() => Shift(1);

    private Task Shift(int offset)
    {
        var index = Months.ToList().FindIndex(m => m.Year == Selected.Year && m.Month == Selected.Month);
        var next = index + offset;
        if (next < 0 || next >= Months.Count)
        {
            return Task.CompletedTask;
        }

        return SelectedChanged.InvokeAsync(Months[next]);
    }
}
