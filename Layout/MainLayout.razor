@inherits LayoutComponentBase
@implements IDisposable
@inject TransactionStateService Finance

<a class="skip-link" href="#main-content">Skip to content</a>

<div class="shell">
    @if (navOpen)
    {
        <div class="nav-backdrop" @onclick="CloseNav"></div>
    }

    <aside id="app-sidebar" class="sidebar @(navOpen ? "is-open" : null)">
        <NavMenu OnNavigate="CloseNav" />
    </aside>

    <div class="workspace">
        <AppHeader Profile="Finance.Profile" NavOpen="navOpen" OnToggleNav="ToggleNav" />
        <main id="main-content" class="workspace-main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool navOpen;

    protected override async Task OnInitializedAsync()
    {
        Finance.Changed += OnChanged;
        await Finance.EnsureLoadedAsync();
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CloseNav() => navOpen = false;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Finance.Changed -= OnChanged;
}
