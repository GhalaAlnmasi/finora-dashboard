@inherits LayoutComponentBase
@implements IDisposable
@inject PreferencesService Preferences
@inject TransactionStateService Finance
@inject BudgetStateService BudgetStore

<a class="skip-link" href="#main-content">Skip to content</a>

<div class="shell" @onkeydown="OnShellKey">
    @if (navOpen)
    {
        <div class="nav-backdrop" @onclick="CloseNav"></div>
    }

    <aside id="app-sidebar" class="sidebar @(navOpen ? "is-open" : null)">
        <NavMenu Profile="Preferences.Profile" OnNavigate="CloseNav" />
    </aside>

    <div class="workspace">
        <AppHeader Profile="Preferences.Profile" NavOpen="navOpen" OnToggleNav="ToggleNav" />
        <main id="main-content" class="workspace-main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool navOpen;

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnChanged;
        Finance.Changed += OnChanged;
        await Preferences.EnsureLoadedAsync();
        await Finance.EnsureLoadedAsync();
        await BudgetStore.EnsureLoadedAsync();
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CloseNav() => navOpen = false;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnShellKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && navOpen)
        {
            CloseNav();
        }
    }

    public void Dispose()
    {
        Preferences.Changed -= OnChanged;
        Finance.Changed -= OnChanged;
    }
}
