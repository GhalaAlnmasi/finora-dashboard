@using finora_dashboard.Services
@inject TransactionStateService Finance

<div class="nav-root">
<div class="brand">
    <a class="brand__link" href="" @onclick="OnNavigate" @onclick:preventDefault="false">
        <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <rect width="32" height="32" rx="10" fill="#C8E8DA" />
                <path d="M10 23V9h12M10 16h8" stroke="#166B57" stroke-width="2.2" stroke-linecap="round" />
            </svg>
        </span>
        <span class="brand__word">
            FINORA
            <small>Personal finance</small>
        </span>
    </a>
    <button type="button" class="brand__close" aria-label="Close navigation" @onclick="OnNavigate">
        <Icon Name="close" />
    </button>
</div>

<nav class="menu" aria-label="Primary">
    <NavLink class="menu__link" href="" Match="NavLinkMatch.All" @onclick="OnNavigate">
        <Icon Name="overview" />
        Overview
    </NavLink>
    <NavLink class="menu__link" href="transactions" @onclick="OnNavigate">
        <Icon Name="transactions" />
        Transactions
    </NavLink>
    <NavLink class="menu__link" href="budgets" @onclick="OnNavigate">
        <Icon Name="budgets" />
        Budgets
    </NavLink>
    <NavLink class="menu__link" href="analytics" @onclick="OnNavigate">
        <Icon Name="analytics" />
        Analytics
    </NavLink>
    <NavLink class="menu__link" href="settings" @onclick="OnNavigate">
        <Icon Name="settings" />
        Settings
    </NavLink>
</nav>

<div class="menu__profile">
    <span class="menu__avatar" aria-hidden="true">@Finance.Profile.Initials</span>
    <div>
        <p>@Finance.Profile.FullName</p>
        <small>Demo · local data</small>
    </div>
</div>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
}
